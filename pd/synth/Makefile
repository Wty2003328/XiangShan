# XiangShan ASAP7 Synthesis Makefile
# Synthesizes XSTop from pre-generated RTL in build/rtl/

DESIGN_NAME          = XSTop
RTL_DIR              = ../../build/rtl

# ASAP7 7nm RVT TT NLDM synthesis (500 MHz, 2000ps period)
ASAP7_FOUNDRY_PATH  = /mnt/spr8nfs/asap7pdk/LIB/NLDM
ASAP7_TECH_NAME     = asap7
ASAP7_TARGET_LIBS   = asap7sc7p5t_AO_RVT_TT_nldm_211120.db asap7sc7p5t_INVBUF_RVT_TT_nldm_220122.db asap7sc7p5t_OA_RVT_TT_nldm_211120.db asap7sc7p5t_SEQ_RVT_TT_nldm_220123.db asap7sc7p5t_SIMPLE_RVT_TT_nldm_211120.db
ASAP7_PERIOD        = 2000
ASAP7_INPUT_DELAY   = 100
ASAP7_OUTPUT_DELAY  = 100
ASAP7_DC_SHELL_PATH = /soft/synopsys/syn/V-2023.12-SP3/bin/
ASAP7_NAND2_AREA    = 1

# SRAM macro .db files (generated by FakeRAM2.0_xs) — all 21 SRAMs
SRAM_DB_DIR         = .
SRAM_DB_FILES       = fakeram7_8192x64.db fakeram7_1024x160.db fakeram7_1024x56.db \
                      fakeram7_1024x7.db fakeram7_512x308.db fakeram7_256x24.db \
                      fakeram7_256x16.db fakeram7_128x230.db fakeram7_128x100.db \
                      fakeram7_128x50.db fakeram7_128x40.db fakeram7_64x192.db \
                      fakeram7_64x64.db fakeram7_32x1024.db fakeram7_32x108.db \
                      fakeram7_4x1044.db fakeram7_4x2672.db \
                      fakeram7_2048x4.db fakeram7_256x24_0.db \
                      fakeram7_8x236.db fakeram7_8x512.db

# Simulation-only files to EXCLUDE from synthesis
SIM_EXCLUDE = SimTop.sv XiangShanSim.sv SimMMIO.sv DifftestMem1R1W.sv

# All 21 array modules replaced by FakeRAM wrappers
SRAM_ARRAY_EXCLUDE = array_0_8192x64 array_0_1024x7 array_1024x160 array_1024x56 \
                     array_512x308 array_256x24 array_256x16 array_128x230 \
                     array_128x100 array_128x50 array_128x40 array_64x192 \
                     array_64x64 array_32x1024 array_32x108 array_4x1044 \
                     array_4x2672 array_2048x4 array_256x24_0 array_8x236 \
                     array_8x512

# Generate file list from build/rtl/ (exclude sim-only files)
pre_xs_synth:
	@if [ ! -d "$(RTL_DIR)" ]; then \
		echo "ERROR: RTL directory not found: $(RTL_DIR)"; \
		echo "       Run 'make sim-verilog CONFIG=MinimalConfig NUM_CORES=1' first."; \
		exit 1; \
	fi
	@echo "Generating Flist.xs_synth from $(RTL_DIR)..."
	@(cd $(RTL_DIR) && ls -1 *.sv 2>/dev/null) | \
		grep -v -E '^(SimTop|XiangShanSim|SimMMIO|DifftestMem1R1W)\.sv$$' | \
		sed 's|^|analyze -f sverilog -lib xs_lib $(RTL_DIR)/|' > Flist.xs_synth
	@echo "Generated Flist.xs_synth with $$(wc -l < Flist.xs_synth) entries"

# For SRAM macro mode: exclude all 21 array modules replaced by FakeRAM wrappers
pre_xs_sram_synth:
	@if [ ! -d "$(RTL_DIR)" ]; then \
		echo "ERROR: RTL directory not found: $(RTL_DIR)"; \
		echo "       Run 'make sim-verilog CONFIG=MinimalConfig NUM_CORES=1' first."; \
		exit 1; \
	fi
	@echo "Generating Flist.xs_synth (SRAM macro mode) from $(RTL_DIR)..."
	@(cd $(RTL_DIR) && ls -1 *.sv 2>/dev/null) | \
		grep -v -E '^(SimTop|XiangShanSim|SimMMIO|DifftestMem1R1W)\.sv$$' | \
		grep -v -E '^(array_0_8192x64|array_0_1024x7|array_1024x160|array_1024x56|array_512x308|array_256x24|array_256x16|array_128x230|array_128x100|array_128x50|array_128x40|array_64x192|array_64x64|array_32x1024|array_32x108|array_4x1044|array_4x2672|array_2048x4|array_256x24_0|array_8x236|array_8x512)\.sv$$' | \
		sed 's|^|analyze -f sverilog -lib xs_lib $(RTL_DIR)/|' > Flist.xs_synth
	@echo "Generated Flist.xs_synth with $$(wc -l < Flist.xs_synth) entries (SRAM macro mode)"

# ASAP7 synthesis with SRAM macros (recommended — replaces all 21 SRAMs with FakeRAM)
asap7_minimal_synth: pre_xs_sram_synth
	@echo "Starting ASAP7 MinimalConfig SRAM macro synthesis with period=$(ASAP7_PERIOD)ps"
	@export SNPSLMD_QUEUE=TRUE TECH_NAME=$(ASAP7_TECH_NAME) DESIGN_NAME=$(DESIGN_NAME) TERM=vt100 PERIOD=$(ASAP7_PERIOD) FOUNDRY_PATH=$(ASAP7_FOUNDRY_PATH) TARGET_LIBRARY_FILES="$(ASAP7_TARGET_LIBS)" INPUT_DELAY=$(ASAP7_INPUT_DELAY) OUTPUT_DELAY=$(ASAP7_OUTPUT_DELAY) USE_SRAM_MACROS=1 SRAM_DB_DIR=$(SRAM_DB_DIR) SRAM_DB_FILES="$(SRAM_DB_FILES)"; $(ASAP7_DC_SHELL_PATH)/dc_shell -f ./xs_synth.tcl -output synthesis_batch.log
	cp synthesis_batch.log $(DESIGN_NAME)_xs/
	mv $(DESIGN_NAME)_synth.v $(DESIGN_NAME)_xs_synth.v 2>/dev/null || true
	-mv $(DESIGN_NAME)_synth.v.sdf $(DESIGN_NAME)_xs_synth.v.sdf 2>/dev/null || true
	echo $(ASAP7_NAND2_AREA) > $(DESIGN_NAME)_xs/nand2area.txt

# ASAP7 synthesis without SRAM macros (all arrays as register arrays — VERY SLOW)
asap7_minimal_synth_no_sram: pre_xs_synth
	@echo "Starting ASAP7 MinimalConfig synthesis (no SRAM macros) with period=$(ASAP7_PERIOD)ps"
	@export SNPSLMD_QUEUE=TRUE TECH_NAME=$(ASAP7_TECH_NAME) DESIGN_NAME=$(DESIGN_NAME) TERM=vt100 PERIOD=$(ASAP7_PERIOD) FOUNDRY_PATH=$(ASAP7_FOUNDRY_PATH) TARGET_LIBRARY_FILES="$(ASAP7_TARGET_LIBS)" INPUT_DELAY=$(ASAP7_INPUT_DELAY) OUTPUT_DELAY=$(ASAP7_OUTPUT_DELAY); $(ASAP7_DC_SHELL_PATH)/dc_shell -f ./xs_synth.tcl -output synthesis_batch.log
	cp synthesis_batch.log $(DESIGN_NAME)_xs/
	mv $(DESIGN_NAME)_synth.v $(DESIGN_NAME)_xs_synth.v 2>/dev/null || true
	-mv $(DESIGN_NAME)_synth.v.sdf $(DESIGN_NAME)_xs_synth.v.sdf 2>/dev/null || true
	echo $(ASAP7_NAND2_AREA) > $(DESIGN_NAME)_xs/nand2area.txt

# ASAP7 synthesis for DefaultConfig (full dual-core)
asap7_full_synth: pre_xs_sram_synth
	@echo "Starting ASAP7 DefaultConfig SRAM macro synthesis with period=$(ASAP7_PERIOD)ps"
	@export SNPSLMD_QUEUE=TRUE TECH_NAME=$(ASAP7_TECH_NAME) DESIGN_NAME=$(DESIGN_NAME) TERM=vt100 PERIOD=$(ASAP7_PERIOD) FOUNDRY_PATH=$(ASAP7_FOUNDRY_PATH) TARGET_LIBRARY_FILES="$(ASAP7_TARGET_LIBS)" INPUT_DELAY=$(ASAP7_INPUT_DELAY) OUTPUT_DELAY=$(ASAP7_OUTPUT_DELAY) USE_SRAM_MACROS=1 SRAM_DB_DIR=$(SRAM_DB_DIR) SRAM_DB_FILES="$(SRAM_DB_FILES)"; $(ASAP7_DC_SHELL_PATH)/dc_shell -f ./xs_synth.tcl -output synthesis_batch.log
	cp synthesis_batch.log $(DESIGN_NAME)_xs/
	mv $(DESIGN_NAME)_synth.v $(DESIGN_NAME)_xs_synth.v 2>/dev/null || true
	-mv $(DESIGN_NAME)_synth.v.sdf $(DESIGN_NAME)_xs_synth.v.sdf 2>/dev/null || true
	echo $(ASAP7_NAND2_AREA) > $(DESIGN_NAME)_xs/nand2area.txt

clean:
	@rm -rf work alib* *_LIB *log *svf Flist.xs_synth $(DESIGN_NAME)_xs default.svf

.PHONY: pre_xs_synth pre_xs_sram_synth asap7_minimal_synth asap7_minimal_synth_no_sram asap7_full_synth clean
